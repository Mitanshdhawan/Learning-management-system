NODE_ENV=development
PORT=4000
WEB_APP_URL=http://localhost:3000

# JWT — use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cloudinary — fill all three to store avatars/media in Cloudinary (else stored locally).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Note: DATABASE_URL lives in packages/db/.env (owned by the db package).
