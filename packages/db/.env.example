# Postgres connection strings used by Prisma (Neon example).
# Free option without a credit card: Neon (https://neon.tech).
#
# DATABASE_URL = pooled endpoint (has "-pooler") + pgbouncer=true — used at runtime.
# DIRECT_URL   = direct endpoint (no "-pooler")               — used for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
