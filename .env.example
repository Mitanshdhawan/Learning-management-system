# Central reference of every env var used across the monorepo.
# Copy the relevant block into each app's own .env (never commit real .env files).

# ---- Database (packages/db) — Neon ----
# DATABASE_URL = pooled endpoint (runtime); DIRECT_URL = direct endpoint (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- API auth (apps/api) ----
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ---- Cloudinary (assets & video) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email (invites & notifications) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TOP LMS <no-reply@toplms.local>"

# ---- URLs ----
WEB_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
